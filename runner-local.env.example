# Copy this file to runner-local.env for local development only.
# Never commit real credentials or tokens.

REMOTE_CODE_CONTROL_PLANE_URL=https://control-plane.example.com
REMOTE_CODE_CONTROL_PLANE_AUTH_TOKEN=replace-with-control-plane-device-or-shared-token
REMOTE_CODE_RUNNER_ID=desktop-local-dev
# Protects only the optional direct runner HTTP API. Do not reuse the control-plane token here.
REMOTE_CODE_RUNNER_AUTH_TOKEN=replace-with-runner-token
# Legacy only: keep disabled unless an old browser client cannot send headers.
# REMOTE_CODE_RUNNER_ALLOW_QUERY_ACCESS_TOKEN=false

# Optional provider credentials for local smoke tests.
OPENAI_API_KEY=replace-with-openai-api-key
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
