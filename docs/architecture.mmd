graph TB
    subgraph GUI["GUI Layer - Tauri + React"]
        direction TB
        GUI_Tauri["remote-code-gui\n(Tauri desktop app)"]
        GUI_Frontend["React Frontend\nRemoteShell / RemoteApp"]
        GUI_TS["TypeScript Types\napi.ts / types.ts / i18n.ts"]
    end

    subgraph Apps["Binary Applications"]
        direction TB
        Runner["remote-code-runner\n(session host)"]
        CP["remote-code-control-plane\n(REST API + registry)"]
        Migrate["remote-code-migrate\n(DB migrations)"]
        CLI["agents/claudecode\n(CLI agent)"]
    end

    subgraph Adapters["Agent Adapter Layer - crates/adapters/"]
        direction TB
        ClaudeAdapter["rc-claude-adapter"]
        RooAdapter["rc-roo-adapter"]
        CodexAdapter["rc-codex-adapter"]
    end

    subgraph Shared["Shared Protocol - crates/shared/"]
        direction TB
        AgentProtocol["rc-agent-protocol\nAgentAdapter trait\nUnifiedAgentEvent"]
        Bridge["bridge.rs\nunified_event_to_runtime_detail"]
        EngineEvents["rc-engine-events\nRuntimeEventDetail 15 variants"]
    end

    subgraph RunnerLib["Runner Infrastructure - crates/claude/"]
        direction TB
        RunnerLib_core["claude-runner\nRunnerApi / broadcast channel"]
    end

    subgraph CPStack["Control Plane Stack - crates/claude/"]
        direction TB
        CP_core["claude-control-plane\nSessionState / handlers / registry"]
        EventBus["claude-event-bus"]
        Telemetry["claude-telemetry"]
    end

    subgraph ClaudeEngine["Claude Engine - crates/claude/"]
        direction TB
        ClaudeCore["claude-core"]
        ClaudeQuery["claude-query-engine"]
        ClaudeSession["claude-session"]
        ClaudeProvider["claude-provider"]
        ClaudeTools["claude-tools"]
        ClaudePerms["claude-permissions"]
        ClaudeConfig["claude-config"]
    end

    subgraph RooEngine["Roo Code Engine - crates/roo/"]
        direction TB
        RooApp["roo-app"]
        RooTask["roo-task / roo-types"]
        RooProvider["roo-provider\n+ 20+ provider plugins"]
        RooTools["roo-tools / roo-prompt / roo-modes"]
        RooTerm["roo-terminal / roo-mcp"]
    end

    subgraph CodexEngine["Codex Engine - crates/codex/"]
        direction TB
        CodexCore["codex-core / codex-protocol"]
        CodexExec["codex-exec-server"]
        CodexState["codex-state / codex-config"]
        CodexAppSrv["codex-app-server-client\ncodex-app-server-protocol"]
        CodexFB["codex-feedback / codex-arg0"]
    end

