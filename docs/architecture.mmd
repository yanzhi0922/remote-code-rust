graph TB
    subgraph GUI["GUI Layer - Tauri + React"]
        direction TB
        GUI_Tauri["remote-code-gui\n(Tauri desktop app)"]
        GUI_Frontend["React Frontend\nRemoteShell / RemoteApp"]
        GUI_TS["TypeScript Types\napi.ts / types.ts / i18n.ts"]
    end

    subgraph Apps["Binary Applications"]
        direction TB
        Runner["remote-code-runner\n(session host)"]
        CP["remote-code-control-plane\n(REST API + registry)"]
        Migrate["remote-code-migrate\n(DB migrations)"]
        CLI["agents/claudecode\n(CLI agent)"]
    end

    subgraph Adapters["Agent Adapter Layer - crates/adapters/"]
        direction TB
        ClaudeAdapter["rc-claude-adapter\nClaudeInProcessAdapter\n~887 lines"]
        RooAdapter["rc-roo-adapter\nRooInProcessAdapter\n~2860 lines"]
        CodexAdapter["rc-codex-adapter\nCodexInProcessAdapter\n~2091 lines"]
    end

    subgraph Shared["Shared Protocol - crates/shared/ (6 crates)"]
        direction TB
        AgentProtocol["rc-agent-protocol\nAgentAdapter trait (8 methods)\nUnifiedAgentEvent (20+ variants)"]
        Bridge["bridge.rs\nunified_event_to_runtime_detail"]
        EngineEvents["rc-engine-events\nRuntimeEventDetail (15 variants)\nEngineEvent (22 variants)"]
        SharedRunner["rc-runner\nRunnerApi / broadcast channel"]
        SharedCP["rc-control-plane\nSessionState / handlers / registry"]
        RunnerHost["rc-runner-host\nrunner hosting logic"]
    end

    subgraph ClaudeEngine["Claude Engine - crates/claude/ (~44 crates)"]
        direction TB
        ClaudeCore["claude-core"]
        ClaudeQuery["claude-query-engine"]
        ClaudeSession["claude-session"]
        ClaudeProvider["claude-provider"]
        ClaudeTools["claude-tools\n50+ built-in tools"]
        ClaudePerms["claude-permissions\n5 permission modes"]
        ClaudeConfig["claude-config"]
        ClaudeAuth["claude-auth\nJWT + keychain"]
        ClaudeEventBus["claude-event-bus"]
        ClaudeTelemetry["claude-telemetry"]
    end

    subgraph RooEngine["Roo Code Engine - crates/roo/ (~72 crates)"]
        direction TB
        RooApp["roo-app"]
        RooTask["roo-task / roo-types\n~30K lines"]
        RooProvider["roo-provider\n+ 25+ provider plugins"]
        RooTools["roo-tools / roo-prompt / roo-modes"]
        RooTerm["roo-terminal / roo-mcp"]
    end

    subgraph CodexEngine["Codex Engine - crates/codex/ (~97 crates)"]
        direction TB
        CodexCore["codex-core / codex-protocol"]
        CodexExec["codex-exec-server"]
        CodexState["codex-state / codex-config\n50+ feature flags"]
        CodexAppSrv["codex-app-server-client\ncodex-app-server-protocol"]
        CodexFB["codex-feedback / codex-arg0"]
    end

    GUI_Frontend -->|"WebSocket SSE\nevents stream"| Runner
    GUI_Frontend -->|"REST API\nauth / discovery / pairing"| CP
    GUI_Tauri -->|"Tauri IPC"| GUI_Frontend
    GUI_TS --> GUI_Frontend

    Runner -->|"hosts sessions\nbroadcasts events"| SharedRunner
    Runner --> SharedCP
    Runner --> AgentProtocol
    CP --> SharedCP
    Migrate -->|"schema migrations"| SharedCP

    ClaudeAdapter -->|"implements"| AgentProtocol
    RooAdapter -->|"implements"| AgentProtocol
    CodexAdapter -->|"implements"| AgentProtocol

    ClaudeAdapter --> ClaudeQuery
    ClaudeAdapter --> ClaudeCore
    ClaudeAdapter --> ClaudeSession
    RooAdapter --> RooApp
    RooAdapter --> RooProvider
    CodexAdapter --> CodexCore
    CodexAdapter --> CodexAppSrv

    AgentProtocol --> Bridge
    AgentProtocol --> EngineEvents

    Bridge -->|"UnifiedAgentEvent to\nRuntimeEventDetail"| SharedRunner

    SharedRunner -->|"publish_stream_event\ntokio broadcast"| GUI_Frontend
    EngineEvents --> SharedCP
    SharedCP --> ClaudeEventBus
    SharedCP --> ClaudeTelemetry

    GUI_Tauri -->|"optional in-process\nagent hosting"| ClaudeAdapter
    GUI_Tauri -->|"optional in-process\nagent hosting"| RooAdapter
    GUI_Tauri -->|"optional in-process\nagent hosting"| CodexAdapter

    CLI --> SharedRunner
    CLI --> SharedCP
    CLI --> ClaudeAdapter

