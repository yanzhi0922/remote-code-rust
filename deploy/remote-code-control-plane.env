# Control Plane Environment Variables
# Deploy to: remote-code.yz520gzy.top (49.235.163.138)
# Relay-only cloud host: do not put provider API keys or workspace paths here.

# Bind to localhost (Caddy proxies to this)
REMOTE_CODE_CONTROL_PLANE_BIND=127.0.0.1:8787

# Public URL
REMOTE_CODE_CONTROL_PLANE_PUBLIC_BASE_URL=https://remote-code.yz520gzy.top

# State directory for cloud control-plane metadata only.
REMOTE_CODE_PROFILE_DIR=/var/lib/remote-code/control-plane

# Auth — always require auth in production
# Set a strong auth token for the runner to use
REMOTE_CODE_CONTROL_PLANE_AUTH_TOKEN=

# Bootstrap secret for first-time owner device claim
# Generate with: openssl rand -hex 32
REMOTE_CODE_CONTROL_PLANE_BOOTSTRAP_SECRET=

# Require auth for all protected endpoints
REMOTE_CODE_REQUIRE_AUTH=true

# Downloads directory for app binaries (Windows installer, APK, IPA, etc.)
# Place app binaries here; they'll be served at /download after login
REMOTE_CODE_DOWNLOADS_DIR=/opt/remote-code/downloads
