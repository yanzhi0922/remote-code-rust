[Unit]
Description=Remote Code Control Plane
After=network.target

[Service]
Type=simple
User=remote-code
Group=remote-code
WorkingDirectory=/opt/remote-code
EnvironmentFile=/etc/remote-code/control-plane.env
ExecStart=/opt/remote-code/bin/remote-code-control-plane serve
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/remote-code /opt/remote-code/downloads

[Install]
WantedBy=multi-user.target
