{
    # Enable HTTP/3 (QUIC) support on all HTTPS servers.
    servers {
        protocols h1 h2 h3
    }
}

remote-code.yz520gzy.top {
    root * /opt/remote-code/frontend
    encode zstd gzip

    @api {
        path /v1/* /healthz /download /downloads/*
    }
    handle @api {
        reverse_proxy 127.0.0.1:8787
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}
