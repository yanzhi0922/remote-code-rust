# WARNING: Change REMOTE_CODE_CONTROL_PLANE_BOOTSTRAP_SECRET before first boot!
# Relay-only cloud host: do not put provider API keys or workspace paths here.
REMOTE_CODE_CONTROL_PLANE_BIND=127.0.0.1:8787
REMOTE_CODE_CONTROL_PLANE_PUBLIC_BASE_URL=https://remote-code.yz520gzy.top
REMOTE_CODE_CORS_ORIGINS=https://remote-code.yz520gzy.top,tauri://localhost,http://tauri.localhost
REMOTE_CODE_CONTROL_PLANE_BOOTSTRAP_SECRET=change-this-before-first-boot
# Optional legacy username/password tenant flow. Values are sha256(user_key),
# where user_key = sha256(username:password). Prefer owner-device pairing.
# REMOTE_CODE_CONTROL_PLANE_USER_KEY_HASHES=sha256:replace-with-derived-user-key-hash
REMOTE_CODE_PROFILE_DIR=/var/lib/remote-code/control-plane
REMOTE_CODE_DOWNLOADS_DIR=/opt/remote-code/downloads
