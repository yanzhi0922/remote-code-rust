{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Capabilities for mobile platforms (iOS/Android)",
  "windows": ["main"],
  "platforms": ["iOS", "android"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "biometric:allow-status",
    "biometric:allow-authenticate",
    "haptics:allow-notification-feedback",
    "deep-link:default",
    "notification:default",
    "share:allow-share-file"
  ]
}
