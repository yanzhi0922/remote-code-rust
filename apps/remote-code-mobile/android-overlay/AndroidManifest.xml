<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml overrides for Remote Code mobile app.
  
  After running `npx cap add android`, merge these entries into
  android/app/src/main/AndroidManifest.xml:
  
  1. Add the intent-filter for the `remotecode://` custom URL scheme
     inside the <activity> element.
  
  2. Add WRITE_EXTERNAL_STORAGE permission for file downloads
     (only needed for Android < 10; scoped storage is used on 10+).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- File download permission (scoped storage on Android 10+) -->
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
      android:maxSdkVersion="28" />

  <!--
    Add this intent-filter inside the main <activity> element:
    
    <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="remotecode" />
    </intent-filter>
  -->

</manifest>
