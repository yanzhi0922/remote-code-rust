<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info.plist overrides for Remote Code mobile app (iOS).
  
  After running `npx cap add ios`, merge these entries into
  ios/App/App/Info.plist:
  
  1. Add the CFBundleURLTypes entry for the `remotecode://` custom URL scheme.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Add this entry to register the remotecode:// URL scheme:
    
    <key>CFBundleURLTypes</key>
    <array>
      <dict>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>remotecode</string>
        </array>
        <key>CFBundleURLName</key>
        <string>com.remotecode.app</string>
      </dict>
    </array>
  -->
</dict>
</plist>
